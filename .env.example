# Fewer environment. Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres pooled connection string (a dedicated project for Fewer).
DATABASE_URL=

# Neon AI Gateway: bare host, e.g. https://<branch>-api.ai.<region>.aws.neon.tech (no path).
NEON_AI_GATEWAY_BASE_URL=
# Neon AI Gateway bearer token (nt_live_...).
NEON_AI_GATEWAY_TOKEN=
# Optional fallback if the gateway is unavailable (models become anthropic/claude-*).
ANTHROPIC_API_KEY=

# AgentMail API key (agentmail.to).
AGENTMAIL_API_KEY=
# Exa API key (exa.ai) for "who is asking?" research.
EXA_API_KEY=

# The agent's inbox id/address, e.g. fewer-xyz@agentmail.to (printed by scripts/setup-inboxes.ts).
FEWER_INBOX=
# Approver address (owner demo inbox); only YES <CODE> replies from here approve, e.g. rahul-demo-xyz@agentmail.to.
FEWER_APPROVER=
# Demo "event host" inbox used by the seed script.
FEWER_HOST_DEMO=

# Owner's first name, used in drafts and the signature, e.g. Rahul.
FEWER_OWNER_NAME=
# Owner's IANA time zone (default America/Los_Angeles).
FEWER_TZ=

# Fast/cheap model for parsing (default neon/claude-haiku-4-5, else anthropic/claude-haiku-4-5).
FEWER_MODEL_FAST=
# Drafting/chat model (default neon/claude-sonnet-4-6, else anthropic/claude-sonnet-4-6).
FEWER_MODEL_DRAFT=

# Set to "false" to dry-run outbound mail (logs instead of sending); anything else sends.
FEWER_ALLOW_SEND=

# Deploy only (set with `fly secrets set`, never in .env.local, or it gates your local Desk).
# The Desk password. Unset in production, every route answers 503 until it is set.
# DESK_PASSWORD=
# Set to "off" to run a production Desk with no password on purpose. Not recommended: anyone
# could then approve sends from the agent's inbox.
# DESK_GATE=
